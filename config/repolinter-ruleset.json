import React, { useState } from "react";
import { Button } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
import { ShoppingCart, Pencil, Trash2 } from "lucide-react";

export default function LampShop() {
  const [products, setProducts] = useState([
    {
      id: 1,
      name: "Stolná lampa Nordlux",
      price: 39.99,
      image: "https://via.placeholder.com/300x200",
    },
    {
      id: 2,
      name: "Závesná lampa Philips",
      price: 79.99,
      image: "https://via.placeholder.com/300x200",
    },
    {
      id: 3,
      name: "Stropné svietidlo Eglo",
      price: 59.99,
      image: "https://via.placeholder.com/300x200",
    },
  ]);

  const [cart, setCart] = useState([]);
  const [step, setStep] = useState("shop");
  const [customer, setCustomer] = useState({ name: "", email: "", address: "" });
  const [paymentMethod, setPaymentMethod] = useState("dobierka");
  const [adminProduct, setAdminProduct] = useState({ name: "", price: "", image: "" });
  const [editId, setEditId] = useState(null);

  const addToCart = (product) => {
    setCart((prev) => {
      const existing = prev.find((item) => item.id === product.id);
      if (existing) {
        return prev.map((item) =>
          item.id === product.id ? { ...item, quantity: item.quantity + 1 } : item
        );
      }
      return [...prev, { ...product, quantity: 1 }];
    });
  };

  const total = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);

  const handleOrder = (e) => {
    e.preventDefault();
    alert(
      `Objednávka prijatá!\nMeno: ${customer.name}\nEmail: ${customer.email}\nSpôsob platby: ${paymentMethod === "dobierka" ? "Dobierka (platba pri doručení)" : paymentMethod}`
    );
    setCart([]);
    setCustomer({ name: "", email: "", address: "" });
    setPaymentMethod("dobierka");
    setStep("shop");
  };

  const handleAdminSubmit = (e) => {
    e.preventDefault();
    if (editId) {
      setProducts((prev) =>
        prev.map((p) => (p.id === editId ? { ...p, ...adminProduct, price: parseFloat(adminProduct.price) } : p))
      );
      setEditId(null);
      alert("Produkt upravený!");
    } else {
      const newProduct = {
        id: Date.now(),
        name: adminProduct.name,
        price: parseFloat(adminProduct.price),
        image: adminProduct.image || "https://via.placeholder.com/300x200",
      };
      setProducts([...products, newProduct]);
      alert("Produkt pridaný!");
    }
    setAdminProduct({ name: "", price: "", image: "" });
  };

  const handleEdit = (product) => {
    setEditId(product.id);
    setAdminProduct({ name: product.name, price: product.price.toString(), image: product.image });
  };

  const handleDelete = (id) => {
    if (confirm("Naozaj chcete zmazať tento produkt?")) {
      setProducts(products.filter((p) => p.id !== id));
    }
  };

  return (
    <div className="p-8">
      <h1 className="text-3xl font-bold mb-6">Lampa Shop</h1>

      <div className="mb-4 flex gap-2">
        <Button variant="outline" onClick={() => setStep("shop")}>Obchod</Button>
        <Button variant="outline" onClick={() => setStep("checkout")}>Objednávka</Button>
        <Button variant="outline" onClick={() => setStep("admin")}>Admin</Button>
      </div>

      {step === "shop" && (
        <>
          <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 mb-12">
            {products.map((product) => (
              <Card key={product.id} className="rounded-2xl shadow-md">
                <img
                  src={product.image}
                  alt={product.name}
                  className="w-full h-48 object-cover rounded-t-2xl"
                />
                <CardContent className="p-4">
                  <h2 className="text-xl font-semibold mb-2">{product.name}</h2>
                  <p className="text-lg font-bold mb-4">{product.price.toFixed(2)} €</p>
                  <Button
                    className="w-full flex items-center justify-center gap-2"
                    onClick={() => addToCart(product)}
                  >
                    <ShoppingCart size={18} /> Pridať do košíka
                  </Button>
                </CardContent>
              </Card>
            ))}
          </div>

          <div className="border-t pt-6">
            <h2 className="text-2xl font-semibold mb-4">🛒 Košík</h2>
            {cart.length === 0 ? (
              <p>Košík je prázdny.</p>
            ) : (
              <>
                <ul className="space-y-3 mb-4">
                  {cart.map((item) => (
                    <li key={item.id} className="flex justify-between">
                      <span>
                        {item.name} x {item.quantity}
                      </span>
                      <span>{(item.price * item.quantity).toFixed(2)} €</span>
                    </li>
                  ))}
                  <li className="font-bold text-lg flex justify-between">
                    <span>Spolu</span>
                    <span>{total.toFixed(2)} €</span>
                  </li>
                </ul>
                <Button onClick={() => setStep("checkout")} className="mt-2 w-full">
                  Pokračovať k objednávke
                </Button>
              </>
            )}
          </div>
        </>
      )}

      {step === "checkout" && (
        <form onSubmit={handleOrder} className="max-w-lg mx-auto space-y-4">
          <h2 className="text-2xl font-semibold mb-4">📝 Objednávka</h2>
          <input
            type="text"
            required
            placeholder="Meno"
            className="w-full border rounded-lg p-2"
            value={customer.name}
            onChange={(e) => setCustomer({ ...customer, name: e.target.value })}
          />
          <input
            type="email"
            required
            placeholder="Email"
            className="w-full border rounded-lg p-2"
            value={customer.email}
            onChange={(e) => setCustomer({ ...customer, email: e.target.value })}
          />
          <textarea
            required
            placeholder="Adresa"
            className="w-full border rounded-lg p-2"
            value={customer.address}
            onChange={(e) => setCustomer({ ...customer, address: e.target.value })}
          />

          <div>
            <label className="block mb-1 font-medium">Spôsob platby</label>
            <select
              value={paymentMethod}
              onChange={(e) => setPaymentMethod(e.target.value)}
              className="w-full border rounded-lg p-2"
            >
              <option value="dobierka">Dobierka (platba pri doručení)</option>
              <option value="card" disabled>Platba kartou (čoskoro)</option>
            </select>
          </div>

          <Button type="submit" className="w-full">
            Odoslať objednávku
          </Button>
        </form>
      )}

      {step === "admin" && (
        <div className="max-w-3xl mx-auto space-y-8">
          <form onSubmit={handleAdminSubmit} className="space-y-4">
            <h2 className="text-2xl font-semibold mb-2">🛠️ {editId ? "Upraviť produkt" : "Pridať produkt"}</h2>
            <input
              type="text"
              required
              placeholder="Názov lampy"
              className="w-full border rounded-lg p-2"
              value={adminProduct.name}
              onChange={(e) => setAdminProduct({ ...adminProduct, name: e.target.value })}
            />
            <input
              type="number"
              step="0.01"
              required
              placeholder="Cena (€)"
              className="w-full border rounded-lg p-2"
              value={adminProduct.price}
              onChange={(e) => setAdminProduct({ ...adminProduct, price: e.target.value })}
            />
            <input
              type="text"
              placeholder="Obrázok URL (nepovinné)"
              className="w-full border rounded-lg p-2"
              value={adminProduct.image}
              onChange={(e) => setAdminProduct({ ...adminProduct, image: e.target.value })}
            />
            <Button type="submit" className="w-full">
              {editId ? "Uložiť zmeny" : "Pridať produkt"}
            </Button>
          </form>

          <div className="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {products.map((product) => (
              <Card key={product.id} className="relative shadow-md rounded-2xl">
                <img
                  src={product.image}
                  alt={product.name}
                  className="w-full h-40 object-cover rounded-t-2xl"
                />
                <CardContent className="p-4">
                  <h3 className="font-bold text-lg">{product.name}</h3>
                  <p className="text-sm mb-2">{product.price.toFixed(2)} €</p>
                  <div className="flex gap-2">
                    <Button onClick={() => handleEdit(product)} variant="outline" size="sm">
                      <Pencil size={16} /> Upraviť
                    </Button>
                    <Button onClick={() => handleDelete(product.id)} variant="destructive" size="sm">
                      <Trash2 size={16} /> Zmazať
                    </Button>
                  </div>
                </CardContent>
              </Card>
            ))}
          </div>
        </div>
      )}
    </div>
  );
}
